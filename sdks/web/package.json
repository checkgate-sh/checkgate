{
  "name": "@checkgate/web",
  "version": "0.1.24",
  "description": "Checkgate feature-flag SDK for the web \u2014 local evaluation via WebAssembly.",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "dist/checkgate.d.ts",
  "exports": {
    ".": "./index.js",
    "./core": "./core.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checkgate-sh/checkgate.git",
    "directory": "sdks/web"
  },
  "homepage": "https://github.com/checkgate-sh/checkgate#readme",
  "bugs": {
    "url": "https://github.com/checkgate-sh/checkgate/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "wasm-pack build --target web --out-name checkgate --out-dir dist",
    "prepublishOnly": "node scripts/bundle-rust.cjs",
    "test": "vitest run"
  },
  "files": [
    "index.js",
    "cache-key.js",
    "core.js",
    "dist/",
    "rust-core/",
    "Cargo.toml"
  ],
  "devDependencies": {
    "vitest": "^4.1.3"
  }
}
