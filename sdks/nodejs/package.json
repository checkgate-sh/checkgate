{
  "name": "@checkgate/node",
  "version": "0.1.24",
  "description": "Checkgate feature-flag SDK for Node.js — local evaluation via Rust NAPI.",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/checkgate-sh/checkgate.git",
    "directory": "sdks/nodejs"
  },
  "homepage": "https://github.com/checkgate-sh/checkgate#readme",
  "bugs": {
    "url": "https://github.com/checkgate-sh/checkgate/issues"
  },
  "license": "Apache-2.0",
  "files": [
    "index.js",
    "index.d.ts",
    "native-binding.js",
    "native-binding.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "checkgate",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js native-binding.js --dts native-binding.d.ts",
    "build:zig": "napi build --platform --release --zig --js native-binding.js --dts native-binding.d.ts",
    "build:cross": "napi build --platform --release --use-napi-cross --js native-binding.js --dts native-binding.d.ts",
    "build:debug": "napi build --platform --js native-binding.js --dts native-binding.d.ts",
    "test": "node --test"
  },
  "dependencies": {
    "eventsource": "^4.1.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.5.1"
  }
}
