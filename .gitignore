# Rust
target/

# Node / Bun — dependencies are installed by each package's own
# `npm install` / `bun install`; never commit them.
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
server/public/
coverage/

# Dart / Flutter — tool state and build/test caches are machine-specific and
# regenerated by `flutter pub get` / `flutter test`.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
sdks/flutter/dart/build/

# TypeScript incremental build state — regenerated by every `tsc -b`, so
# tracking it churns the diff on each commit.
*.tsbuildinfo

# The docs site is a pnpm project (docs/pnpm-lock.yaml, installed with
# --frozen-lockfile in CI); a stray bun.lock or package-lock.json here means
# two competing lockfiles.
docs/bun.lock
docs/package-lock.json

# macOS
.DS_Store

# Env files
.env
.env.*
!.env.example

# One-time setup token written by a local server that has not been set up.
checkgate-setup-token

# Internal engineering reports and working notes — kept locally, never
# committed. Release records (assessments, reviews, readiness reports, A/B
# outputs) go in internal_docs/releases/<version>/. docs/ is the public
# VitePress site; releases that were tracked under docs/releases/ up to
# v0.1.31 RC3 remain in Git history.
internal_docs/
docs/releases/

# Profiling output.
*.profraw
*.profdata
*.cpuprofile
*.heapprofile

# Benchmark scratch: session credentials and docker stats captures written
# while bench/public/run.sh runs.
bench/public/.work/
# Output of the local A/B scripts (bench/ab/); results worth keeping are
# copied into internal_docs/releases/<version>/results/.
bench/ab/out/
