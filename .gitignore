# Rust
target/

# Node / Bun
dashboard/node_modules/
docs/node_modules/
docs/.vitepress/dist/
server/public/

# TypeScript incremental build state — regenerated by every `tsc -b`, so
# tracking it churns the diff on each commit.
*.tsbuildinfo

# The docs site is a pnpm project (docs/pnpm-lock.yaml); a stray bun.lock here
# means two competing lockfiles.
docs/bun.lock

# macOS
.DS_Store

# Env files
.env
.env.*
!.env.example

# One-time setup token written by a local server that has not been set up.
checkgate-setup-token
