# Rust
target/

# Node / Bun — dependencies are installed by each package's own
# `npm install` / `bun install`; never commit them.
node_modules/
docs/.vitepress/dist/
server/public/
coverage/

# Dart / Flutter — tool state and build/test caches are machine-specific and
# regenerated by `flutter pub get` / `flutter test`.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
sdks/flutter/dart/build/

# TypeScript incremental build state — regenerated by every `tsc -b`, so
# tracking it churns the diff on each commit.
*.tsbuildinfo

# The docs site is a pnpm project (docs/pnpm-lock.yaml); a stray bun.lock here
# means two competing lockfiles.
docs/bun.lock

# macOS
.DS_Store

# Env files
.env
.env.*
!.env.example

# One-time setup token written by a local server that has not been set up.
checkgate-setup-token
